{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "paths": {
      "@farm/game": ["../../packages/game/src/index.ts"],
      "@farm/game/*": ["../../packages/game/src/*"],
      "@farm/game-ui": ["../../packages/game-ui/src/index.ts"],
      "@farm/game-ui/*": ["../../packages/game-ui/src/*"]
    }
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts", "build-wechat.mjs"]
}
